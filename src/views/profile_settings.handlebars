<div class="container mt-4">
	<div class="row">
		<div class="col-lg-8 mx-auto">
			<div class="card shadow">
				<div class="card-header bg-primary text-white">
					<h4 class="mb-0">
						<i class="fas fa-user-cog"></i> Configuración de Perfil
					</h4>
				</div>
				<div class="card-body">
					{{#if success}}
						<div class="alert alert-success alert-dismissible fade show" role="alert">
							<i class="fas fa-check-circle"></i> Configuración actualizada correctamente
							<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
						</div>
					{{/if}}

					<form method="POST" action="/player/profile/settings">
						<!-- Privacy Settings -->
						<div class="card mb-4">
							<div class="card-header bg-light">
								<h5 class="mb-0">
									<i class="fas fa-shield-alt"></i> Privacidad
								</h5>
							</div>
							<div class="card-body">
								<div class="form-check form-switch">
									<input 
										class="form-check-input" 
										type="checkbox" 
										role="switch" 
										id="is_private" 
										name="is_private"
										{{#if is_private}}checked{{/if}}
									>
									<label class="form-check-label" for="is_private">
										<strong>Perfil Privado</strong>
									</label>
								</div>
								<div class="form-text mt-2">
									<i class="fas fa-info-circle text-info"></i>
									Si activas esta opción, otros jugadores solo podrán ver tu posición en el ranking, 
									pero no podrán acceder a tus estadísticas detalladas, torneos jugados, ni historial de partidas. 
									Los administradores siempre podrán ver tu información completa.
								</div>
							</div>
						</div>

						<!-- Email Settings -->
						<div class="card mb-4">
							<div class="card-header bg-light">
								<h5 class="mb-0">
									<i class="fas fa-envelope"></i> Información de Contacto
								</h5>
							</div>
							<div class="card-body">
								<div class="mb-3">
									<label for="email" class="form-label">Email (Opcional)</label>
									<input 
										type="email" 
										class="form-control" 
										id="email" 
										name="email" 
										value="{{email}}"
										placeholder="tu@email.com"
									>
									<div class="form-text">
										<i class="fas fa-info-circle text-info"></i>
										Tu email no será visible públicamente y solo se usará para notificaciones importantes.
									</div>
								</div>
							</div>
						</div>

						<!-- Action Buttons -->
						<div class="d-grid gap-2 d-md-flex justify-content-md-end">
							<a href="/player" class="btn btn-secondary">
								<i class="fas fa-times"></i> Cancelar
							</a>
							<button type="submit" class="btn btn-primary">
								<i class="fas fa-save"></i> Guardar Cambios
							</button>
						</div>
					</form>
				</div>
			</div>

			<!-- Account Info -->
			<div class="card shadow mt-4">
				<div class="card-header bg-light">
					<h5 class="mb-0">
						<i class="fas fa-user"></i> Información de Cuenta
					</h5>
				</div>
				<div class="card-body">
					<div class="row">
						<div class="col-md-6">
							<p class="mb-1">
								<strong>Usuario:</strong>
							</p>
							<p class="text-muted">{{username}}</p>
						</div>
						<div class="col-md-6">
							<p class="mb-1">
								<strong>Estado del Perfil:</strong>
							</p>
							<p class="mb-0">
								{{#if is_private}}
									<span class="badge bg-warning text-dark">
										<i class="fas fa-lock"></i> Privado
									</span>
								{{else}}
									<span class="badge bg-success">
										<i class="fas fa-globe"></i> Público
									</span>
								{{/if}}
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	// Auto-dismiss success message after 5 seconds
	const urlParams = new URLSearchParams(window.location.search);
	if (urlParams.get('success') === 'true') {
		setTimeout(() => {
			const alert = document.querySelector('.alert-success');
			if (alert) {
				alert.classList.remove('show');
				setTimeout(() => alert.remove(), 150);
			}
		}, 5000);
	}
</script>
