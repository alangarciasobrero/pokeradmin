<div class="container-fluid mt-4">
	<div class="row mb-4">
		<div class="col">
			<a href="/admin/dashboard" class="btn btn-secondary">← Volver al Admin</a>
		</div>
	</div>

	<div class="row">
		<div class="col-lg-4">
			<!-- User Info Card -->
			<div class="card shadow mb-4">
				<div class="card-header bg-primary text-white">
					<h4 class="mb-0">
						<i class="fas fa-user"></i> {{targetUser.username}}
					</h4>
				</div>
				<div class="card-body">
					<div class="mb-3">
						<strong>Nombre completo:</strong><br>
						{{#if targetUser.full_name}}
							{{targetUser.full_name}}
						{{else}}
							<em>No especificado</em>
						{{/if}}
					</div>
					<div class="mb-3">
						<strong>Puntos actuales:</strong><br>
						<span class="badge bg-warning text-dark fs-4">{{targetUser.current_points}} pts</span>
					</div>

					<!-- Form para actualizar puntos directamente -->
					<form method="POST" action="/admin/users/{{targetUser.id}}/update-points" class="mt-3">
						<div class="mb-3">
							<label for="current_points" class="form-label">
								<i class="fas fa-edit"></i> Establecer puntos manualmente
							</label>
							<input 
								type="number" 
								class="form-control" 
								id="current_points" 
								name="current_points" 
								value="{{targetUser.current_points}}"
								required
							>
							<div class="form-text">
								Esto sobreescribe los puntos actuales del usuario (no suma ni resta).
							</div>
						</div>
						<button type="submit" class="btn btn-primary w-100">
							<i class="fas fa-save"></i> Actualizar Puntos
						</button>
					</form>
				</div>
			</div>

			<!-- Add Historical Point Card -->
			<div class="card shadow mb-4">
				<div class="card-header bg-success text-white">
					<h5 class="mb-0">
						<i class="fas fa-plus-circle"></i> Agregar Registro Histórico
					</h5>
				</div>
				<div class="card-body">
					<form method="POST" action="/admin/users/{{targetUser.id}}/add-historical-point">
						<div class="mb-3">
							<label for="points" class="form-label">Puntos *</label>
							<input 
								type="number" 
								class="form-control" 
								id="points" 
								name="points" 
								required
								placeholder="100"
							>
							<div class="form-text">Usar números negativos para restar puntos</div>
						</div>

						<div class="mb-3">
							<label for="reason" class="form-label">Razón *</label>
							<select class="form-select" id="reason" name="reason" required>
								<option value="manual">Ajuste Manual</option>
								<option value="asistencia">Bonus Asistencia</option>
								<option value="reentry">Bonus Reentry</option>
								<option value="weekly">Bonus Semanal</option>
								<option value="monthly">Bonus Mensual</option>
								<option value="season">Bonus Temporada</option>
								<option value="final_table">Mesa Final</option>
								<option value="correction">Corrección</option>
								<option value="migration">Migración de datos</option>
							</select>
						</div>

						<div class="mb-3">
							<label for="description" class="form-label">Descripción</label>
							<textarea 
								class="form-control" 
								id="description" 
								name="description" 
								rows="2"
								placeholder="Ej: Puntos por asistencia del mes de enero"
							></textarea>
						</div>

						<div class="mb-3">
							<label for="season_id" class="form-label">Temporada (opcional)</label>
							<select class="form-select" id="season_id" name="season_id">
								<option value="">-- Sin temporada --</option>
								{{#each seasons}}
									<option value="{{this.id}}">{{this.nombre}}</option>
								{{/each}}
							</select>
						</div>

						<div class="mb-3">
							<label for="tournament_id" class="form-label">Torneo (opcional)</label>
							<select class="form-select" id="tournament_id" name="tournament_id">
								<option value="">-- Sin torneo --</option>
								{{#each tournaments}}
									<option value="{{this.id}}">{{this.tournament_name}} - {{formatDate this.start_date}}</option>
								{{/each}}
							</select>
						</div>

						<div class="mb-3">
							<label for="record_date" class="form-label">Fecha del registro</label>
							<input 
								type="date" 
								class="form-control" 
								id="record_date" 
								name="record_date"
								value="{{formatDateInput (new Date)}}"
							>
						</div>

						<button type="submit" class="btn btn-success w-100">
							<i class="fas fa-plus"></i> Agregar Registro
						</button>
					</form>
				</div>
			</div>

			<!-- Add Tournament Registration Card -->
			<div class="card shadow">
				<div class="card-header bg-info text-white">
					<h5 class="mb-0">
						<i class="fas fa-ticket-alt"></i> Registrar en Torneo
					</h5>
				</div>
				<div class="card-body">
					<form method="POST" action="/admin/users/{{targetUser.id}}/add-tournament-registration">
						<div class="mb-3">
							<label for="tournament_id_reg" class="form-label">Torneo *</label>
							<select class="form-select" id="tournament_id_reg" name="tournament_id" required>
								<option value="">-- Seleccionar torneo --</option>
								{{#each tournaments}}
									<option value="{{this.id}}">{{this.tournament_name}} - {{formatDate this.start_date}}</option>
								{{/each}}
							</select>
						</div>

						<div class="mb-3">
							<label for="action_type" class="form-label">Tipo *</label>
							<select class="form-select" id="action_type" name="action_type" required>
								<option value="1">Buy-in</option>
								<option value="2">Reentry</option>
								<option value="3">Duplo</option>
							</select>
						</div>

						<button type="submit" class="btn btn-info w-100">
							<i class="fas fa-user-plus"></i> Registrar
						</button>
					</form>
				</div>
			</div>
		</div>

		<!-- Historical Points List -->
		<div class="col-lg-8">
			{{#if flash}}
				<div class="alert alert-{{flash.type}} alert-dismissible fade show" role="alert">
					{{flash.message}}
					<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
				</div>
			{{/if}}

			<div class="card shadow">
				<div class="card-header bg-dark text-white">
					<h4 class="mb-0">
						<i class="fas fa-history"></i> Historial de Puntos (últimos 50)
					</h4>
				</div>
				<div class="card-body p-0">
					{{#if historicalPoints.length}}
						<div class="table-responsive">
							<table class="table table-striped table-hover mb-0">
								<thead class="table-dark">
									<tr>
										<th>Fecha</th>
										<th>Puntos</th>
										<th>Razón</th>
										<th>Descripción</th>
										<th>Torneo</th>
										<th>Temporada</th>
										<th>Acciones</th>
									</tr>
								</thead>
								<tbody>
									{{#each historicalPoints}}
										<tr>
											<td>{{formatDate this.record_date}}</td>
											<td>
												{{#if (gt this.points 0)}}
													<span class="badge bg-success">+{{this.points}}</span>
												{{else}}
													<span class="badge bg-danger">{{this.points}}</span>
												{{/if}}
											</td>
											<td>
												<span class="badge bg-secondary">{{this.reason}}</span>
											</td>
											<td>{{this.description}}</td>
											<td>
												{{#if this.tournament_id}}
													<small class="text-muted">ID: {{this.tournament_id}}</small>
												{{else}}
													-
												{{/if}}
											</td>
											<td>
												{{#if this.season_id}}
													<small class="text-muted">ID: {{this.season_id}}</small>
												{{else}}
													-
												{{/if}}
											</td>
											<td>
												<form method="POST" action="/admin/users/historical-points/{{this.id}}/delete" style="display: inline;" onsubmit="return confirm('¿Eliminar este registro? Esto restará {{this.points}} puntos del usuario.')">
													<button type="submit" class="btn btn-sm btn-danger">
														<i class="fas fa-trash"></i>
													</button>
												</form>
											</td>
										</tr>
									{{/each}}
								</tbody>
							</table>
						</div>
					{{else}}
						<div class="text-center p-5">
							<i class="fas fa-inbox fa-3x text-muted mb-3"></i>
							<p class="text-muted">No hay registros históricos de puntos</p>
						</div>
					{{/if}}
				</div>
			</div>
		</div>
	</div>
</div>

<style>
.card {
	border: none;
}

.card-header {
	border-bottom: 3px solid rgba(0,0,0,0.1);
}

.table-responsive {
	max-height: 600px;
	overflow-y: auto;
}

.badge {
	font-size: 0.9rem;
}
</style>
