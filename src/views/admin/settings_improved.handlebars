					</div>
					<div class="form-field">
						<label>🥉 Semanal - Nivel 2 (Bronce)</label>
						<input type="number" name="bonus_weekly_3days" value="{{config.bonus_weekly_3days}}" min="0" step="1" required />
						<small>Puntos otorgados</small>
					</div>
					<div class="form-field">
						<label>🥉 Jornadas Requeridas</label>
						<input type="number" name="bonus_weekly_3days_required" value="{{config.bonus_weekly_3days_required}}" min="1" step="1" required />
						<small>Días por semana</small>
					</div>
				</div>

				<h3 style="margin-top: 25px; margin-bottom: 15px; color: #4fc3f7;">Bonos Mensuales</h3>
				<div class="form-grid" style="grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));">
					<div class="form-field">
						<label>🥈 Mensual (Plata)</label>
						<input type="number" name="bonus_monthly_12days" value="{{config.bonus_monthly_12days}}" min="0" step="1" required />
						<small>Puntos otorgados</small>
					</div>
					<div class="form-field">
						<label>🥈 Jornadas Requeridas</label>
						<input type="number" name="bonus_monthly_required" value="{{config.bonus_monthly_required}}" min="1" step="1" required />
						<small>Días por mes</small>
					</div>
				</div>

				<h3 style="margin-top: 25px; margin-bottom: 15px; color: #4fc3f7;">Bonos de Temporada</h3>
				<div class="form-grid" style="grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));">
					<div class="form-field">
						<label>🥇 Temporada - Nivel 1 (Oro)</label>
						<input type="number" name="bonus_season_30days" value="{{config.bonus_season_30days}}" min="0" step="1" required />
						<small>Puntos otorgados</small>
					</div>
					<div class="form-field">
						<label>🥇 Jornadas Requeridas</label>
						<input type="number" name="bonus_season_30days_required" value="{{config.bonus_season_30days_required}}" min="1" step="1" required />
						<small>Días en temporada</small>
					</div>
					<div class="form-field">
						<label>💎 Temporada - Nivel 2 (Diamante)</label>
						<input type="number" name="bonus_season_35days" value="{{config.bonus_season_35days}}" min="0" step="1" required />
						<small>Puntos otorgados</small>
					</div>
					<div class="form-field">
						<label>💎 Jornadas Requeridas</label>
