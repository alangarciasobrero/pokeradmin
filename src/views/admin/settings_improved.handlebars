						<input type="number" name="prize_position_16" value="{{lookup prizeDistribution '16'}}" min="0" max="100" step="0.1" />
					</div>
					<div class="form-field">
						<label>17º Lugar (%)</label>
						<input type="number" name="prize_position_17" value="{{lookup prizeDistribution '17'}}" min="0" max="100" step="0.1" />
					</div>
					<div class="form-field">
						<label>18º Lugar (%)</label>
						<input type="number" name="prize_position_18" value="{{lookup prizeDistribution '18'}}" min="0" max="100" step="0.1" />
					</div>
					<div class="form-field">
