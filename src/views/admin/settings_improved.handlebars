		{{!-- Sección: Configuración de Comisiones --}}
		<div class="settings-card quick-access-card">
			<div class="card-icon">💰</div>
			<h2>Comisiones</h2>
			<p class="card-description">Gestiona destinos y porcentajes de distribución de comisiones</p>
			
			<div class="quick-access-content">
				<p>Configura múltiples destinos de comisión:</p>
				<ul class="feature-list">
					<li>🏠 Casa</li>
					<li>🏆 Rankings de temporada</li>
					<li>⭐ Torneos especiales (Copa Don Humberto, etc)</li>
				</ul>
				<p class="info-text">Sistema completo con validación de porcentajes y tracking de acumulados</p>
			</div>
			
			<div class="form-actions">
				<a href="/admin/games/settings/commissions" class="btn btn-primary">⚙️ Configurar Comisiones</a>
			</div>
		</div>

		{{!-- Sección: Sistema de Puntos por Torneo --}}
		<div class="settings-card">
			<div class="card-icon">⭐</div>
			<h2>Sistema de Puntos por Torneo</h2>
			<p class="card-description">Configura los puntos del pozo del torneo y personales</p>
			
			<form method="post" action="/admin/games/settings/tournament-points" class="settings-form">
				<h3 style="margin-top: 0; color: #ffd700;">🎁 Puntos Personales (Directos)</h3>
				<div class="form-grid" style="grid-template-columns: 1fr 1fr;">
					<div class="form-field">
						<label>👤 Presencia (Buy-in)</label>
						<input type="number" name="personal_buyin" value="{{config.personal_buyin_points}}" min="0" step="10" required />
						<small>Puntos que recibe cada jugador por participar</small>
					</div>
					<div class="form-field">
						<label>🔄 Re-entry</label>
						<input type="number" name="personal_reentry" value="{{config.personal_reentry_points}}" min="0" step="10" required />
						<small>Puntos adicionales por cada re-entry</small>
					</div>
				</div>

				<hr style="margin: 20px 0; border: 1px solid #333;">

				<h3 style="color: #4a9eff;">🏆 Grupos de Días con Puntos</h3>
				<p style="font-size: 0.9rem; color: #888; margin-bottom: 15px;">
					Crea grupos de días con diferentes puntos. Por ejemplo: "Lunes-Martes" con 150 pts, "Viernes" con 200 pts.
				</p>

				<div id="dayGroupsContainer" style="display: flex; flex-direction: column; gap: 15px;">
					<!-- Los grupos se cargarán aquí dinámicamente -->
				</div>

				<button type="button" onclick="addDayGroup()" style="background: #4a9eff; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; margin-top: 10px;">
					➕ Agregar Grupo de Días
				</button>

				<input type="hidden" id="dayGroupsData" name="day_groups_config" value="" />

				<div class="info-box" style="background: #1a1a2e; padding: 15px; border-radius: 8px; margin-top: 15px;">
					<h4 style="margin: 0 0 10px 0; color: #ffd700;">ℹ️ Ranking Especial</h4>
					<p style="margin: 0; font-size: 0.9rem; color: #ccc;">
						Los torneos pueden tener <strong>doble ranking</strong> (×2) o <strong>triple ranking</strong> (×3), lo que multiplica los puntos de <strong>buy-in</strong> que van al pozo. Los puntos personales y de re-entry NO se multiplican.
					</p>
				</div>

				<script>
					let dayGroups = [];
					const dayNames = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];

					// Cargar configuración existente
					try {
						const configStr = '{{config.day_groups_config}}';
						if (configStr && configStr !== 'undefined' && configStr !== '') {
							dayGroups = JSON.parse(configStr.replace(/&quot;/g, '"'));
						}
					} catch (e) {
						console.log('No hay configuración previa o error al parsear:', e);
					}

					// Si no hay grupos, crear uno por defecto
					if (dayGroups.length === 0) {
						dayGroups = [
							{ name: 'Lunes/Miércoles/Viernes', days: [1, 3, 5], buyinPoints: 150, reentryPoints: 100 }
						];
					}

					function addDayGroup() {
						dayGroups.push({
							name: 'Nuevo Grupo',
							days: [],
							buyinPoints: 150,
							reentryPoints: 100
						});
						renderDayGroups();
					}

					function removeDayGroup(index) {
						if (confirm('¿Eliminar este grupo de días?')) {
							dayGroups.splice(index, 1);
							renderDayGroups();
						}
					}

					function updateDayGroup(index, field, value) {
						if (field === 'days') {
							const dayNum = parseInt(value);
							const dayIndex = dayGroups[index].days.indexOf(dayNum);
							if (dayIndex > -1) {
								dayGroups[index].days.splice(dayIndex, 1);
							} else {
								dayGroups[index].days.push(dayNum);
							}
							dayGroups[index].days.sort((a, b) => a - b);
						} else {
							dayGroups[index][field] = field === 'name' ? value : parseInt(value);
						}
						updateHiddenInput();
					}

					function updateHiddenInput() {
						document.getElementById('dayGroupsData').value = JSON.stringify(dayGroups);
					}

					function renderDayGroups() {
						const container = document.getElementById('dayGroupsContainer');
						container.innerHTML = dayGroups.map((group, index) => `
							<div style="background: #2a2a3e; padding: 15px; border-radius: 8px; border: 1px solid #444;">
								<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
									<input type="text" 
										value="${group.name}" 
										onchange="updateDayGroup(${index}, 'name', this.value)"
										style="background: #1a1a2e; border: 1px solid #555; color: white; padding: 8px; border-radius: 4px; font-size: 1rem; font-weight: bold; flex: 1; margin-right: 10px;" 
										placeholder="Nombre del grupo" />
									<button type="button" onclick="removeDayGroup(${index})" style="background: #d32f2f; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer;">
										🗑️ Eliminar
									</button>
								</div>
								
								<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 10px; margin-bottom: 15px;">
									${dayNames.map((day, dayNum) => `
										<label style="display: flex; align-items: center; gap: 5px; cursor: pointer; color: ${group.days.includes(dayNum) ? '#4a9eff' : '#ccc'};">
											<input type="checkbox" 
												${group.days.includes(dayNum) ? 'checked' : ''} 
												onchange="updateDayGroup(${index}, 'days', ${dayNum}); renderDayGroups();"
												style="cursor: pointer;" />
											<span>${day}</span>
										</label>
									`).join('')}
								</div>

								<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
									<div>
										<label style="display: block; font-size: 0.85rem; color: #aaa; margin-bottom: 5px;">💰 Buy-in al Pozo</label>
										<input type="number" 
											value="${group.buyinPoints}" 
											onchange="updateDayGroup(${index}, 'buyinPoints', this.value)"
											min="0" step="10"
											style="width: 100%; background: #1a1a2e; border: 1px solid #555; color: white; padding: 8px; border-radius: 4px;" />
									</div>
									<div>
										<label style="display: block; font-size: 0.85rem; color: #aaa; margin-bottom: 5px;">🔄 Re-entry al Pozo</label>
										<input type="number" 
											value="${group.reentryPoints}" 
											onchange="updateDayGroup(${index}, 'reentryPoints', this.value)"
											min="0" step="10"
											style="width: 100%; background: #1a1a2e; border: 1px solid #555; color: white; padding: 8px; border-radius: 4px;" />
									</div>
								</div>
							</div>
						`).join('');
						
						updateHiddenInput();
					}

					// Renderizar al cargar
					renderDayGroups();
				</script>

				<div class="form-actions">
					<button type="submit" class="btn btn-primary">💾 Guardar Puntos Torneo</button>
				</div>
			</form>
		</div>

		<div class="settings-card">
			<div class="card-icon">🎁</div>
			<h2>Bonos de Asistencia</h2>
			<p class="card-description">Configura los puntos extra por consistencia y asistencia</p>
			
