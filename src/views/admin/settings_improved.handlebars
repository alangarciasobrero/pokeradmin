						<small>Puntos por cada re-entry</small>
					</div>
				</div>

				<h3 style="margin-top: 25px; margin-bottom: 15px; color: #4fc3f7;">Bonos Semanales</h3>
				<div class="form-grid" style="grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));">
					<div class="form-field">
						<label>🏵️ Semanal - Nivel 1</label>
						<input type="number" name="bonus_weekly_4days" value="{{config.bonus_weekly_4days}}" min="0" step="1" required />
