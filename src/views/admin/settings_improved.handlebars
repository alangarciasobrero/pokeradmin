						<input type="number" name="prize_position_5" value="{{lookup prizeDistribution '5'}}" min="0" max="100" step="0.1" required />
					</div>
					<div class="form-field">
						<label>6º Lugar (%)</label>
						<input type="number" name="prize_position_6" value="{{lookup prizeDistribution '6'}}" min="0" max="100" step="0.1" required />
					</div>
					<div class="form-field">
						<label>7º Lugar (%)</label>
						<input type="number" name="prize_position_7" value="{{lookup prizeDistribution '7'}}" min="0" max="100" step="0.1" required />
					</div>
					<div class="form-field">
						<label>8º Lugar (%)</label>
						<input type="number" name="prize_position_8" value="{{lookup prizeDistribution '8'}}" min="0" max="100" step="0.1" required />
					</div>
					<div class="form-field">
						<label>9º Lugar (%)</label>
						<input type="number" name="prize_position_9" value="{{lookup prizeDistribution '9'}}" min="0" max="100" step="0.1" required />
